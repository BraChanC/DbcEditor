<Window x:Class="DbcEditor.Views.MessageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DbcEditor.Controls"

        Title="Message" Height="556" Width="813"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
  </Window.Resources>
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="取消" Width="80" Height="23" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="应用(A)" Width="80" Height="23" Margin="0,0,8,0" Click="OnApply"/>
      <Button Content="帮助" Width="80" Height="23" IsEnabled="False"/>
    </StackPanel>

    <!-- Vector CANdb++: flat tabs Definition | Signals | Transmitters | Receivers | Layout | Attributes | Comment -->
    <TabControl>
      <TabItem Header="Definition">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="80"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22" Text="{Binding Name}"/>
          <TextBlock Grid.Row="1" Text="Type:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22"
                    ItemsSource="{Binding IdFormats}" SelectedItem="{Binding IdFormat}"/>
          <TextBlock Grid.Row="2" Text="ID:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding IdText}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" Text="DLC:" VerticalAlignment="Center" Margin="8,0,0,0"/>
          <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,4" Height="22"
                    ItemsSource="{Binding DlcOptions}" SelectedItem="{Binding Dlc}"/>
          <TextBlock Grid.Row="3" Text="Transmitter:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22"
                    ItemsSource="{Binding TransmitterOptions}" SelectedItem="{Binding Transmitter}"
                    IsEditable="True"/>
          <TextBlock Grid.Row="4" Text="Tx Method:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22"
                    ItemsSource="{Binding TxMethods}" SelectedItem="{Binding TxMethod}"
                    IsEditable="True"/>
          <TextBlock Grid.Row="5" Text="Cycle Time:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22"
                   Text="{Binding CycleTime}"/>
        </Grid>
      </TabItem>

      <TabItem Header="Signals">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add..." Width="72" Height="23" Margin="0,0,8,0" Click="OnAddSignal"/>
            <Button Content="Remove" Width="72" Height="23" Margin="0,0,8,0"
                    Click="OnRemoveSignal" IsEnabled="{Binding HasSelectedSignal}"/>
            <Button Content="View..." Width="72" Height="23" HorizontalAlignment="Right"
                    Click="OnViewSignal" IsEnabled="{Binding HasSelectedSignal}"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding SignalRows}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedSignalRow, Mode=TwoWay}"
                    MouseDoubleClick="OnSignalGridDoubleClick">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Signal" Width="*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="14" Height="14" Margin="0,0,4,0" Cursor="Help"
                              Visibility="{Binding HasOverlapWarning, Converter={StaticResource BoolToVis}}"
                              ToolTip="{Binding OverlapTooltip}">
                        <Viewbox Stretch="Uniform">
                          <Canvas Width="16" Height="16">
                            <Path Fill="#FFFFC107" Stroke="#FFB71C1C" StrokeThickness="0.8"
                                  Data="M8,1.5 L14.5,14 L1.5,14 Z"/>
                            <TextBlock Canvas.Left="5.2" Canvas.Top="5.5" Text="!" FontSize="8"
                                       FontWeight="Bold" FontFamily="Tahoma" Foreground="#FFB71C1C"/>
                          </Canvas>
                        </Viewbox>
                      </Border>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="140"/>
              <DataGridTextColumn Header="Multiplexing/Group" Binding="{Binding Multiplexing}" Width="120"/>
              <DataGridTextColumn Header="Startbit" Binding="{Binding StartBit}" Width="70"/>
              <DataGridTextColumn Header="Length [Bit]" Binding="{Binding Length}" Width="90"/>
              <DataGridTextColumn Header="Byte Order" Binding="{Binding ByteOrder}" Width="90"/>
              <DataGridTextColumn Header="Value Type" Binding="{Binding ValueType}" Width="90"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Transmitters">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add..." Width="72" Height="23" Margin="0,0,8,0" Click="OnAddTransmitter"/>
            <Button Content="Remove" Width="72" Height="23" Margin="0,0,8,0"
                    Click="OnRemoveTransmitter" IsEnabled="{Binding HasSelectedTransmitter}"/>
            <Button Content="View..." Width="72" Height="23"
                    Click="OnViewTransmitter" IsEnabled="{Binding HasSelectedTransmitter}"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Transmitters}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedTransmitter, Mode=TwoWay}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Receivers">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Bottom" Content="View..." Width="80" Height="23"
                  HorizontalAlignment="Right" Margin="0,8,0,0"
                  Click="OnViewReceiver" IsEnabled="{Binding HasSelectedReceiver}"/>
          <DataGrid ItemsSource="{Binding ReceiverNodes}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedReceiver, Mode=TwoWay}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Layout">
        <DockPanel Margin="4">
          <DockPanel DockPanel.Dock="Top" Margin="4,4,4,8">
            <TextBlock Text="Multiplexor Signal:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="200" Height="22" IsEnabled="False"
                      ItemsSource="{Binding MultiplexorOptions}" SelectedIndex="0"/>
          </DockPanel>
          <ctrl:BitLayoutControl x:Name="BitLayout"
                                 Message="{Binding Model}"
                                 SelectedSignal="{Binding SelectedSignal, Mode=TwoWay}"
                                 Margin="2"/>
        </DockPanel>
      </TabItem>

      <TabItem Header="Attributes">
        <ctrl:AttributesPanel Groups="{Binding AttributeGroups}"
                              Database="{Binding Database}"
                              ObjectType="BO_"
                              AttributeCommitted="OnAttributeCommitted"/>
      </TabItem>

      <TabItem Header="Comment">
        <TextBox Margin="8" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Text="{Binding Comment}"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
