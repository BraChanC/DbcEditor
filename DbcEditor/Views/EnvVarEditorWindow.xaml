<Window x:Class="DbcEditor.Views.EnvVarEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DbcEditor.Controls"
        Title="Environment Variable" Height="556" Width="813"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
  </Window.Resources>
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="取消" Width="80" Height="23" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="应用(A)" Width="80" Height="23" Margin="0,0,8,0" Click="OnApply"/>
      <Button Content="帮助" Width="80" Height="23" IsEnabled="False"/>
    </StackPanel>
    <TabControl>
      <!-- Vector: Definition fields depend on Value Type -->
      <TabItem Header="Definition">
        <Grid Margin="16,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Name}"/>

          <TextBlock Grid.Row="1" Text="Value Type:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" Height="22"
                    ItemsSource="{Binding ValueTypes}" SelectedItem="{Binding ValueType}"
                    IsEnabled="{Binding IsValueTypeEnabled}"/>

          <TextBlock Grid.Row="2" Text="Access:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" Height="22"
                    ItemsSource="{Binding AccessModes}" SelectedItem="{Binding Access}"
                    IsEnabled="{Binding IsAccessEnabled}"/>

          <TextBlock Grid.Row="3" Text="Unit:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Unit}"/>

          <TextBlock Grid.Row="4" Text="Value Table:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" Height="22"
                    ItemsSource="{Binding ValueTableOptions}" SelectedItem="{Binding ValueTable}"
                    IsEnabled="{Binding IsValueTableEnabled}"/>

          <!-- Integer / Float: Initial / Min / Max -->
          <TextBlock Grid.Row="5" Text="Initial Value:" VerticalAlignment="Center"
                     Visibility="{Binding ShowNumericRange, Converter={StaticResource BoolVis}}"/>
          <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Height="22"
                   Text="{Binding InitialValueText}"
                   Visibility="{Binding ShowNumericRange, Converter={StaticResource BoolVis}}"/>
          <TextBlock Grid.Row="6" Text="Minimum:" VerticalAlignment="Center"
                     Visibility="{Binding ShowNumericRange, Converter={StaticResource BoolVis}}"/>
          <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Height="22"
                   Text="{Binding MinimumText}"
                   Visibility="{Binding ShowNumericRange, Converter={StaticResource BoolVis}}"/>
          <TextBlock Grid.Row="7" Text="Maximum:" VerticalAlignment="Center"
                     Visibility="{Binding ShowNumericRange, Converter={StaticResource BoolVis}}"/>
          <TextBox Grid.Row="7" Grid.Column="1" Margin="0,4" Height="22"
                   Text="{Binding MaximumText}"
                   Visibility="{Binding ShowNumericRange, Converter={StaticResource BoolVis}}"/>

          <!-- Data: Length [Byte] -->
          <TextBlock Grid.Row="5" Text="Length [Byte]:" VerticalAlignment="Center"
                     Visibility="{Binding ShowDataLength, Converter={StaticResource BoolVis}}"/>
          <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Height="22"
                   Text="{Binding LengthText}"
                   Visibility="{Binding ShowDataLength, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </TabItem>

      <TabItem Header="Control units">
        <DockPanel Margin="8">
          <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="View..." Width="72" Height="23"
                    Click="OnViewControlUnit" IsEnabled="{Binding HasSelectedControlUnit}"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Add..." Width="72" Height="23" Margin="0,0,8,0" Click="OnAddControlUnit"/>
              <Button Content="Remove" Width="72" Height="23"
                      Click="OnRemoveControlUnit" IsEnabled="{Binding HasSelectedControlUnit}"/>
            </StackPanel>
          </DockPanel>
          <DataGrid ItemsSource="{Binding ControlUnits}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedControlUnit, Mode=TwoWay}"
                    AlternatingRowBackground="#FFF7F7F7">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Attributes">
        <ctrl:AttributesPanel Groups="{Binding AttributeGroups}"
                              Database="{Binding Database}"
                              ObjectType="EV_"
                              AttributeCommitted="OnAttributeCommitted"/>
      </TabItem>

      <TabItem Header="Value Descriptions">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add" Width="72" Height="23" Margin="0,0,8,0" Click="OnAddValueDesc"/>
            <Button Content="Remove" Width="72" Height="23" Click="OnRemoveValueDesc"
                    IsEnabled="{Binding HasSelectedValueDesc}"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding ValueDescriptions}" AutoGenerateColumns="False"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedValueDesc, Mode=TwoWay}"
                    AlternatingRowBackground="#FFF7F7F7" GridLinesVisibility="All">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Value" Binding="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
              <DataGridTextColumn Header="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Comment">
        <TextBox Margin="8" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Text="{Binding Comment}"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
