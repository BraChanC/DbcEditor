<Window x:Class="DbcEditor.Views.NodeTxMessageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DbcEditor.Controls"
        Title="Node - Tx Message" Height="556" Width="813"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="应用(A)" Width="80" Margin="0,0,8,0" Click="OnApply"/>
      <Button Content="帮助" Width="80" IsEnabled="False"/>
    </StackPanel>
    <TabControl>
      <TabItem Header="Definition">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Node Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Text="{Binding NodeName}" IsReadOnly="True" Background="#FFF5F5F5"/>
          <TextBlock Grid.Row="1" Text="Message Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding MessageName}" IsReadOnly="True" Background="#FFF5F5F5"/>
          <TextBlock Grid.Row="2" Text="Tx Method:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding TxMethod}" IsReadOnly="True" Background="#FFF5F5F5"/>
        </Grid>
      </TabItem>
      <TabItem Header="Node">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Text="{Binding NodeName}" IsReadOnly="True" Background="#FFF5F5F5"/>
          <TextBlock Grid.Row="1" Text="Address:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding NodeAddress}" IsReadOnly="True" Background="#FFF5F5F5"/>
        </Grid>
      </TabItem>
      <TabItem Header="Message">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Text="{Binding MessageName}"/>
          <TextBlock Grid.Row="1" Text="Type:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" IsEnabled="False"
                    ItemsSource="{Binding IdFormats}" SelectedItem="{Binding IdFormat}"/>
          <TextBlock Grid.Row="2" Text="ID:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding IdText}"/>
          <TextBlock Grid.Row="3" Text="DLC:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding Dlc}"/>
          <TextBlock Grid.Row="4" Text="Transmitter:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" IsEnabled="False"
                    ItemsSource="{Binding Transmitters}" SelectedItem="{Binding Transmitter}"/>
          <TextBlock Grid.Row="5" Text="Tx Method:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" IsEnabled="False"
                    ItemsSource="{Binding TxMethods}" SelectedItem="{Binding TxMethod}"/>
          <TextBlock Grid.Row="6" Text="Cycle Time:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Text="{Binding CycleTime}"/>
        </Grid>
      </TabItem>
      <TabItem Header="Attributes">
        <ctrl:AttributesPanel Groups="{Binding AttributeGroups}"
                              Database="{Binding Database}"
                              ObjectType="BO_"
                              AttributeCommitted="OnAttributeCommitted"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
