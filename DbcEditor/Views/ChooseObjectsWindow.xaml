<Window x:Class="DbcEditor.Views.ChooseObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Objects" Height="480" Width="640"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="OK" Width="80" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="Cancel" Width="80" Height="23" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Help" Width="80" Height="23" IsEnabled="False"/>
    </StackPanel>

    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="Filter by:" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="FilterField" Width="140" Height="22" Margin="0,0,12,0"
                SelectionChanged="OnFilterChanged"/>
      <TextBlock Text="Value:" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBox x:Name="FilterValue" Width="160" Height="22" Margin="0,0,8,0"
               KeyDown="OnFilterKeyDown"/>
      <Button Content="Filter" Width="72" Height="23" Click="OnFilterClick"/>
    </DockPanel>

    <DataGrid x:Name="Grid"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              HeadersVisibility="Column"
              SelectionMode="Extended"
              AlternatingRowBackground="#FFF7F7F7"
              GridLinesVisibility="All"/>
  </DockPanel>
</Window>
