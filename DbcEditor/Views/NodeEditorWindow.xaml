<Window x:Class="DbcEditor.Views.NodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DbcEditor.Controls"
        Title="Node" Height="556" Width="813"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="取消" Width="80" Height="23" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="应用(A)" Width="80" Height="23" Margin="0,0,8,0" Click="OnApply"/>
      <Button Content="帮助" Width="80" Height="23" IsEnabled="False"/>
    </StackPanel>

    <!-- Vector: Definition | Mapped Tx Sig. | Mapped Rx Sig. | Tx Messages |
         Networks | Control units | Attributes | Comment -->
    <TabControl>
      <TabItem Header="Definition">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Name}"/>
          <TextBlock Grid.Row="1" Text="Address:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Address}"/>
        </Grid>
      </TabItem>

      <TabItem Header="Mapped Tx Sig.">
        <DockPanel Margin="4">
          <!-- Vector: Tx signals are derived from Tx messages — View only -->
          <Button DockPanel.Dock="Bottom" Content="View..." Width="72" Height="23"
                  HorizontalAlignment="Right" Margin="0,8,0,0"
                  Click="OnViewTxSignal"
                  IsEnabled="{Binding HasSelectedTxSignal}"/>
          <DataGrid x:Name="TxSigGrid"
                    ItemsSource="{Binding TxSignals}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedTxSignal, Mode=TwoWay}"
                    MouseDoubleClick="OnTxSignalDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Signal" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="140"/>
              <DataGridTextColumn Header="Multiplexing/Group" Binding="{Binding MultiplexingDisplay}" Width="120"/>
              <DataGridTextColumn Header="Startbit" Binding="{Binding StartBit}" Width="70"/>
              <DataGridTextColumn Header="Length [Bit]" Binding="{Binding Length}" Width="90"/>
              <DataGridTemplateColumn Header="Byte Order" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Motorola"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLittleEndian}" Value="True">
                              <Setter Property="Text" Value="Intel"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Value Type" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Unsigned"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSigned}" Value="True">
                              <Setter Property="Text" Value="Signed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Mapped Rx Sig.">
        <DockPanel Margin="4">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add..." Width="72" Height="23" Margin="0,0,8,0" Click="OnAddRxIndividualSignals"/>
            <Button Content="Remove" Width="72" Height="23" Margin="0,0,8,0"
                    Click="OnRemoveRxSignal"
                    IsEnabled="{Binding HasSelectedRxSignal}"/>
            <Button Content="View..." Width="72" Height="23"
                    Click="OnViewRxSignal"
                    IsEnabled="{Binding HasSelectedRxSignal}"/>
          </StackPanel>
          <DataGrid x:Name="RxSigGrid"
                    ItemsSource="{Binding RxSignals}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedRxSignal, Mode=TwoWay}"
                    MouseDoubleClick="OnRxSignalDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Signal" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="140"/>
              <DataGridTextColumn Header="Multiplexing/Group" Binding="{Binding MultiplexingDisplay}" Width="120"/>
              <DataGridTextColumn Header="Startbit" Binding="{Binding StartBit}" Width="70"/>
              <DataGridTextColumn Header="Length [Bit]" Binding="{Binding Length}" Width="90"/>
              <DataGridTemplateColumn Header="Byte Order" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Motorola"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLittleEndian}" Value="True">
                              <Setter Property="Text" Value="Intel"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Value Type" Width="90">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Unsigned"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSigned}" Value="True">
                              <Setter Property="Text" Value="Signed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Tx Messages">
        <DockPanel Margin="4">
          <!-- Vector: View only (edit transmitter on Message dialog) -->
          <Button DockPanel.Dock="Bottom" Content="View..." Width="72" Height="23"
                  HorizontalAlignment="Right" Margin="0,8,0,0"
                  Click="OnViewTxMessage"
                  IsEnabled="{Binding HasSelectedTxMessage}"/>
          <DataGrid ItemsSource="{Binding TxMessages}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedTxMessage, Mode=TwoWay}"
                    MouseDoubleClick="OnTxMessageDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="ID" Binding="{Binding IdHex}" Width="80"/>
              <DataGridTextColumn Header="ID-Format" Binding="{Binding IdFormat}" Width="120"/>
              <DataGridTextColumn Header="DLC [Byte]" Binding="{Binding Dlc}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Networks">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Bottom" Content="View..." Width="80" Height="23"
                  HorizontalAlignment="Right" Margin="0,8,0,0"
                  Click="OnViewNetwork" IsEnabled="{Binding HasSelectedNetwork}"/>
          <DataGrid ItemsSource="{Binding Networks}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}"
                    MouseDoubleClick="OnNetworkDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Control units">
        <DockPanel Margin="8">
          <Button DockPanel.Dock="Bottom" Content="View..." Width="80" Height="23"
                  HorizontalAlignment="Right" Margin="0,8,0,0"
                  Click="OnViewControlUnit" IsEnabled="{Binding HasSelectedControlUnit}"/>
          <DataGrid ItemsSource="{Binding ControlUnits}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedControlUnit, Mode=TwoWay}"
                    MouseDoubleClick="OnControlUnitDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Attributes">
        <ctrl:AttributesPanel Groups="{Binding AttributeGroups}"
                              Database="{Binding Database}"
                              ObjectType="BU_"
                              AttributeCommitted="OnAttributeCommitted"/>
      </TabItem>

      <TabItem Header="Comment">
        <TextBox Margin="8" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Text="{Binding Comment}"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
