<Window x:Class="DbcEditor.Views.NetworkNodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DbcEditor.Controls"
        Title="Network Node" Height="556" Width="813"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="取消" Width="80" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="应用(A)" Width="80" Margin="0,0,8,0" Click="OnApply"/>
      <Button Content="帮助" Width="80" IsEnabled="False"/>
    </StackPanel>
    <TabControl>
      <TabItem Header="Definition">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Network Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Text="{Binding NetworkName}" IsReadOnly="True"
                   Background="#FFF5F5F5"/>
          <TextBlock Grid.Row="1" Text="Node Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding NodeName}"/>
        </Grid>
      </TabItem>
      <TabItem Header="Network">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Text="{Binding NetworkName}" IsReadOnly="True"
                   Background="#FFF5F5F5"/>
          <TextBlock Grid.Row="1" Text="Protocol:" VerticalAlignment="Center"/>
          <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" IsEnabled="False"
                    ItemsSource="{Binding Protocols}" SelectedItem="{Binding Protocol}"/>
        </Grid>
      </TabItem>
      <TabItem Header="Node">
        <Grid Margin="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Text="{Binding NodeName}" IsReadOnly="True"
                   Background="#FFF5F5F5"/>
          <TextBlock Grid.Row="1" Text="Address:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding Address}" IsReadOnly="True"
                   Background="#FFF5F5F5"/>
        </Grid>
      </TabItem>
      <TabItem Header="Attributes">
        <ctrl:AttributesPanel Groups="{Binding AttributeGroups}"
                              Database="{Binding Database}"
                              ObjectType="BU_"
                              AttributeCommitted="OnAttributeCommitted"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
