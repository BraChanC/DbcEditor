<Window x:Class="DbcEditor.Views.SignalEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DbcEditor.Controls"
        Title="Signal" Height="556" Width="813"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="取消" Width="80" Height="23" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="应用(A)" Width="80" Height="23" Margin="0,0,8,0" Click="OnApply"/>
      <Button Content="帮助" Width="80" Height="23" IsEnabled="False"/>
    </StackPanel>

    <!-- Vector: Definition | Messages | Receivers | Attributes | Value Descriptions | Comment -->
    <TabControl>
      <TabItem Header="Definition">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <Grid Margin="12" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Name:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22" Text="{Binding Name}"/>

            <TextBlock Grid.Row="1" Text="Length [Bit]:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Length}"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Startbit:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,4" Height="22" Text="{Binding StartBit}"/>

            <TextBlock Grid.Row="2" Text="Byte Order:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,4" Height="22"
                      ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding ByteOrder}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Value Type:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <ComboBox Grid.Row="2" Grid.Column="3" Margin="0,4" Height="22"
                      ItemsSource="{Binding ValueTypes}" SelectedItem="{Binding ValueType}"/>

            <TextBlock Grid.Row="3" Text="Unit:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22" Text="{Binding Unit}"/>

            <TextBlock Grid.Row="4" Text="Init. Value:" VerticalAlignment="Center" Foreground="#0066CC"/>
            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22"
                     Text="{Binding InitValue}"/>

            <TextBlock Grid.Row="5" Text="Factor:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Factor}"/>
            <TextBlock Grid.Row="5" Grid.Column="2" Text="Offset:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox Grid.Row="5" Grid.Column="3" Margin="0,4" Height="22" Text="{Binding Offset}"/>

            <TextBlock Grid.Row="6" Text="Minimum:" VerticalAlignment="Center"/>
            <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Min}"/>
            <TextBlock Grid.Row="6" Grid.Column="2" Text="Maximum:" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBox Grid.Row="6" Grid.Column="3" Margin="0,4" Height="22" Text="{Binding Max}"/>

            <Button Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4"
                    Content="Calculate minimum and maximum"
                    Height="24" Margin="0,10,0,4" HorizontalAlignment="Stretch"
                    Click="OnCalculateMinMax"/>

            <TextBlock Grid.Row="8" Text="Value Table:" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4" Height="22"
                      ItemsSource="{Binding ValueTableOptions}"
                      SelectedItem="{Binding SelectedValueTable}"/>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Messages">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add..." Width="72" Height="23" Margin="0,0,8,0" Click="OnAddMessage"/>
            <Button Content="Remove" Width="72" Height="23" Margin="0,0,8,0"
                    Click="OnRemoveMessage" IsEnabled="{Binding HasSelectedMessage}"/>
            <Button Content="View..." Width="72" Height="23" HorizontalAlignment="Right"
                    Click="OnViewMessage" IsEnabled="{Binding HasSelectedMessage}"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding Messages}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedMessage, Mode=TwoWay}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="ID" Binding="{Binding IdHex}" Width="80"/>
              <DataGridTextColumn Header="ID-Format" Binding="{Binding IdFormat}" Width="120"/>
              <DataGridTextColumn Header="DLC [Byte]" Binding="{Binding Dlc}" Width="80"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Receivers">
        <DockPanel Margin="8">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add..." Width="72" Height="23" Margin="0,0,8,0" Click="OnAddReceiver"/>
            <Button Content="Remove" Width="72" Height="23" Margin="0,0,8,0"
                    Click="OnRemoveReceiver" IsEnabled="{Binding HasSelectedReceiver}"/>
            <Button Content="View..." Width="72" Height="23" HorizontalAlignment="Right"
                    Click="OnViewReceiver" IsEnabled="{Binding HasSelectedReceiver}"/>
          </StackPanel>
          <DataGrid ItemsSource="{Binding ReceiverNodes}" AutoGenerateColumns="False" IsReadOnly="True"
                    HeadersVisibility="Column" CanUserAddRows="False"
                    SelectedItem="{Binding SelectedReceiver, Mode=TwoWay}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <TabItem Header="Attributes">
        <ctrl:AttributesPanel Groups="{Binding AttributeGroups}"
                              Database="{Binding Database}"
                              ObjectType="SG_"
                              AttributeCommitted="OnAttributeCommitted"/>
      </TabItem>

      <TabItem Header="Value Descriptions">
        <DataGrid ItemsSource="{Binding ValueDescriptions}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" Margin="8">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="120"/>
            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>

      <TabItem Header="Comment">
        <TextBox Margin="8" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Text="{Binding Comment}"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
