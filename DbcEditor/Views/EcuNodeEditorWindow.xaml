<Window x:Class="DbcEditor.Views.EcuNodeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DbcEditor.Controls"
        Title="ECU - Node" Height="556" Width="813"
        MinHeight="400" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0">
  <DockPanel Margin="10">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="确定" Width="80" Height="23" Margin="0,0,8,0" IsDefault="True" Click="OnOk"/>
      <Button Content="取消" Width="80" Height="23" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="应用(A)" Width="80" Height="23" Margin="0,0,8,0" Click="OnApply"/>
      <Button Content="帮助" Width="80" Height="23" IsEnabled="False"/>
    </StackPanel>
    <!-- Vector: ECUs / Name / Name → ECU - Node 'Name' : Definition | ECU | Node | Attributes -->
    <TabControl>
      <TabItem Header="Definition">
        <Grid Margin="16,12" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="ECU Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Height="22" Text="{Binding EcuName}"/>
          <TextBlock Grid.Row="1" Text="Node Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding NodeName}"/>
        </Grid>
      </TabItem>
      <TabItem Header="ECU">
        <Grid Margin="16,12" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Height="22" Text="{Binding EcuName}" IsReadOnly="True"
                   Background="#FFF5F5F5"/>
        </Grid>
      </TabItem>
      <TabItem Header="Node">
        <Grid Margin="16,12" VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Name:" VerticalAlignment="Center"/>
          <TextBox Grid.Column="1" Margin="0,4" Height="22" Text="{Binding NodeName}" IsReadOnly="True"
                   Background="#FFF5F5F5"/>
          <TextBlock Grid.Row="1" Text="Address:" VerticalAlignment="Center"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Height="22" Text="{Binding Address}"/>
        </Grid>
      </TabItem>
      <TabItem Header="Attributes">
        <ctrl:AttributesPanel Groups="{Binding AttributeGroups}"
                              Database="{Binding Database}"
                              ObjectType="BU_"
                              AttributeCommitted="OnAttributeCommitted"/>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
