<Window x:Class="DbcEditor.Views.TemplateSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Template" Height="420" Width="420"
        MinHeight="320" MinWidth="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        FontFamily="Tahoma" FontSize="11"
        Background="#FFF0F0F0"
        ShowInTaskbar="False">
  <Window.Resources>
    <DrawingImage x:Key="DbcTemplateIcon">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFC62828"
                           Geometry="M8,2 L12,2 L12,6 L16,6 L16,10 L12,10 L12,18 L8,18 L8,10 L4,10 L4,6 L8,6 Z"/>
          <GeometryDrawing Brush="#FFC62828"
                           Geometry="M2,10 L6,10 L6,14 L2,14 Z M14,10 L18,10 L18,14 L14,14 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
  </Window.Resources>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="OkButton" Content="OK" Width="80" Margin="0,0,8,0"
              IsDefault="True" Click="OnOk" IsEnabled="False"/>
      <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Help" Width="80" IsEnabled="False"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <TextBlock Text="Template for:" VerticalAlignment="Center" Margin="0,0,8,8"/>
      <ComboBox Grid.Column="1" Margin="0,0,0,8" SelectedIndex="0" IsEditable="False">
        <ComboBoxItem Content="DBC database"/>
      </ComboBox>

      <ListBox x:Name="TemplateList" Grid.Row="1" Grid.ColumnSpan="2"
               BorderBrush="#FF7A7A7A" BorderThickness="1"
               Background="White"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               SelectionChanged="OnSelectionChanged"
               MouseDoubleClick="OnListDoubleClick">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="2,1">
              <Image Source="{StaticResource DbcTemplateIcon}" Width="16" Height="16" Margin="0,0,6,0"
                     Stretch="Uniform" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</Window>
