<Window x:Class="DbcEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DbcEditor.ViewModels"
        Title="{Binding Title}" Height="600" Width="1280"
        MinHeight="480" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Tahoma" FontSize="11"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>
  <Window.Resources>
    <vm:StringEqualsToVisibilityConverter x:Key="EqVis"/>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAsCommand}"/>
  </Window.InputBindings>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_Open..." Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"/>
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"/>
        <MenuItem Header="Save _As..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S"/>
        <MenuItem Header="_Reload" Command="{Binding ReloadCommand}"/>
        <Separator/>
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
      </MenuItem>
      <MenuItem Header="_Edit"/>
      <MenuItem Header="_View"/>
      <MenuItem Header="_Options"/>
      <MenuItem Header="_Window"/>
      <MenuItem Header="_Help"/>
    </Menu>
    <ToolBarTray DockPanel.Dock="Top">
      <ToolBar>
        <Button Content="Open" Command="{Binding OpenCommand}" Padding="8,2"/>
        <Button Content="Save" Command="{Binding SaveCommand}" Padding="8,2"/>
        <Button Content="Save As..." Command="{Binding SaveAsCommand}" Padding="8,2"/>
        <Button Content="Reload" Command="{Binding ReloadCommand}" Padding="8,2"/>
        <Separator/>
        <Button Content="Edit" Command="{Binding EditSelectedCommand}" Padding="8,2"/>
      </ToolBar>
    </ToolBarTray>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusText}"/>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding FilePath}" Opacity="0.7"/>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <!-- Vector CANdb++ left tree ~1/4 of ~1280 -->
        <ColumnDefinition Width="320" MinWidth="200"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*" MinWidth="400"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="4">
        <TextBlock DockPanel.Dock="Top" Text="Networks" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TreeView ItemsSource="{Binding TreeRoots}"
                  SelectedItemChanged="OnTreeSelected"
                  MouseDoubleClick="OnTreeDoubleClick">
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Title}"/>
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

      <DockPanel Grid.Column="2" Margin="4">
        <TextBlock DockPanel.Dock="Top" Text="Overall View" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid>
          <!-- Message overview (Vector) -->
          <DataGrid ItemsSource="{Binding MessageRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedDetail, Mode=TwoWay}"
                    MouseDoubleClick="OnGridDoubleClick"
                    AlternatingRowBackground="#FFF7F7F7"
                    GridLinesVisibility="All"
                    Visibility="{Binding DetailMode, Converter={StaticResource EqVis}, ConverterParameter=Messages}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="160"/>
              <DataGridTextColumn Header="Node" Binding="{Binding Node}" Width="80"/>
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FF0066CC"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="ID-Format" Binding="{Binding IdFormat}" Width="110"/>
              <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="50"/>
              <DataGridTextColumn Header="Tx Method" Binding="{Binding TxMethod}" Width="80"/>
              <DataGridTextColumn Header="Cycle Time" Binding="{Binding CycleTime}" Width="80"/>
              <DataGridTextColumn Header="Transmitter" Binding="{Binding Transmitter}" Width="90"/>
              <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FF0066CC"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="NmMessage" Binding="{Binding NmMessage}" Width="80"/>
              <DataGridTextColumn Header="DiagState" Binding="{Binding DiagState}" Width="70"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Signal overview (Vector Mapped Tx / Signals) -->
          <DataGrid ItemsSource="{Binding SignalRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedDetail, Mode=TwoWay}"
                    MouseDoubleClick="OnGridDoubleClick"
                    AlternatingRowBackground="#FFF7F7F7"
                    GridLinesVisibility="All"
                    Visibility="{Binding DetailMode, Converter={StaticResource EqVis}, ConverterParameter=Signals}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="140"/>
              <DataGridTextColumn Header="Multiplexing" Binding="{Binding Multiplexing}" Width="100"/>
              <DataGridTextColumn Header="Startbit" Binding="{Binding Startbit}" Width="70"/>
              <DataGridTextColumn Header="Length [Bit]" Binding="{Binding Length}" Width="80"/>
              <DataGridTextColumn Header="Byte Order" Binding="{Binding ByteOrder}" Width="90"/>
              <DataGridTextColumn Header="Value Type" Binding="{Binding ValueType}" Width="90"/>
              <DataGridTextColumn Header="Initial Value" Binding="{Binding InitialValue}" Width="90"/>
              <DataGridTextColumn Header="Factor" Binding="{Binding Factor}" Width="70"/>
              <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="70"/>
              <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="70"/>
              <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FF0066CC"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Environment variables (Vector) -->
          <DataGrid ItemsSource="{Binding EnvVarRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedDetail, Mode=TwoWay}"
                    MouseDoubleClick="OnGridDoubleClick"
                    AlternatingRowBackground="#FFF7F7F7"
                    GridLinesVisibility="All"
                    Visibility="{Binding DetailMode, Converter={StaticResource EqVis}, ConverterParameter=EnvVars}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Environment Variable" Binding="{Binding Name}" Width="160"/>
              <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="80"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70"/>
              <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
              <DataGridTextColumn Header="Min" Binding="{Binding Min}" Width="60"/>
              <DataGridTextColumn Header="Max" Binding="{Binding Max}" Width="60"/>
              <DataGridTextColumn Header="Initial Value" Binding="{Binding InitialValue}" Width="90"/>
              <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="60"/>
              <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="80"/>
              <DataGridTextColumn Header="Value Table" Binding="{Binding ValueTable}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Value Table (VtSig_* / VtEv_*) ¡ª Vector: Name | Comment | Usage -->
          <DataGrid ItemsSource="{Binding ValueTableRows}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    CanUserAddRows="False"
                    SelectionMode="Single"
                    SelectedItem="{Binding SelectedDetail, Mode=TwoWay}"
                    MouseDoubleClick="OnGridDoubleClick"
                    AlternatingRowBackground="#FFF7F7F7"
                    GridLinesVisibility="All"
                    Visibility="{Binding DetailMode, Converter={StaticResource EqVis}, ConverterParameter=ValueTables}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#FFCC0000"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/>
              <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="220"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
